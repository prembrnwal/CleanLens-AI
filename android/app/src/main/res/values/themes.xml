<resources>
    <style name="Theme.CleanLensAI" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/accent_blue_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Material 3 surface colors -->
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorSurfaceVariant">@color/card_dark_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_subtitle</item>

        <!-- Checkbox / toggle tint -->
        <item name="colorSecondary">@color/accent_lavender</item>
        <item name="colorTertiary">@color/accent_mint</item>
    </style>

    <!-- Fullscreen theme for ImageViewerActivity (inherits Material3, no action bar) -->
    <style name="Theme.CleanLensAI.Fullscreen" parent="Theme.CleanLensAI">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
